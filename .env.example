# Database
POSTGRES_USER=eduflow
POSTGRES_PASSWORD=eduflow_secret
POSTGRES_DB=eduflow_db
DATABASE_URL=postgresql+asyncpg://eduflow:eduflow_secret@db:5432/eduflow_db

# Redis + Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# JWT
SECRET_KEY=change_this_to_a_long_random_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI
GEMINI_API_KEY=your_gemini_api_key_here

# App
DEBUG=True
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
